on init
    symlink /vendor/odm /odm
    symlink /lib/firmware /vendor/odm/firmware

service recovery-toucheventcheck /system/bin/toucheventcheck
    class main
    user root
    group root system input
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /vendor/odm/lib64:/system/lib64
    oneshot
